{
  "name": "newsblog",
  "version": "1.0.0",
  "private": true,
  "description": "News blog publishing platform — React + Vite frontend, Express + SQLite backend",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "crawl": "npm --prefix server run crawl",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "change-password": "node server/src/change-password.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
