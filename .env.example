# Copy to .env on the server and fill in real values.
# The server reads these from the environment (e.g. via pm2 or systemd).

# Port the Node server listens on (nginx proxies to it)
PORT=3000

# IMPORTANT: long random secret for JWT signing — change this!
# generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: HTTP proxy for the crawler (leave empty on servers with direct internet)
# HTTPS_PROXY=http://127.0.0.1:7897
